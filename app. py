# API Endpoints
@app.get("/api/v1/developer-info/")
def get_developer_info():
    return {"status": "success", "developer": app_info["developer_name"], "title": app_info["developer_title"]}

@app.post("/api/v1/login-user/")
def login_user(data: LoginModel):
    for u_id, u_data in users_db.items():
        if u_data["username"].lower() == data.username.lower():
            if u_data["is_banned"]:
                raise HTTPException(status_code=403, detail="অ্যাকাউন্ট ব্যান করা হয়েছে!")
            return {"status": "success", "user_id": u_id, "username": u_data["username"], "points": u_data["points"], "is_vip": u_data["is_vip"]}
    
    raise HTTPException(status_code=404, detail="অ্যাকাউন্ট পাওয়া যায়নি! প্রথমে রেজিস্টার করুন।")
